# Copy this file to .env and fill in real values.

# Port the demo shop app itself runs on.
PORT=4000

# --- AutoFix AI ingestion ---
# The base URL of your AutoFix AI FastAPI backend.
AUTOFIX_API_URL=http://127.0.0.1:8001

# The per-application ingestion key from AutoFix AI
# (Project -> Environment -> Application -> "New Key" / rotate-key response).
# Looks like: afx_live_9fQ2kD9sV3pXG7c7Kd21mZ8xQvL4nR6t
AUTOFIX_INGESTION_KEY=
